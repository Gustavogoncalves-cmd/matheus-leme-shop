# ============================================================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env.production and fill in the actual values
# NEVER commit .env.production to git - it contains secrets!
# Add .env.production to .gitignore
#
# Generate secrets with:
#   JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Random string: openssl rand -hex 32
#
# ============================================================================

# ============================================================================
# DATABASE (Managed PostgreSQL)
# ============================================================================
# Railway format: postgresql://user:password@container.railway.internal:5432/railway
# Render format: postgresql://user:password@dpg-xxx.render-internal:5432/database
# AWS RDS format: postgresql://user:password@xxx.rds.amazonaws.com:5432/dbname
#
# Get this from your cloud provider dashboard
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================================================
# SECURITY & JWT
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: This MUST be different from development
# Use a strong, random 32+ byte hex string
JWT_SECRET=your_production_jwt_secret_here_generate_with_crypto

# Token expiration
JWT_EXPIRE=7d

# ============================================================================
# PAYMENT INTEGRATION - MERCADOPAGO
# ============================================================================
# Get from: https://www.mercadopago.com/developers/panel
# Production credentials:
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx

# Webhook secret for payment notifications
MERCADOPAGO_WEBHOOK_SECRET=webhook_secret_from_mercadopago

# ============================================================================
# APPLICATION URLS
# ============================================================================
# Frontend URL - used for CORS
# Example: https://matheus-leme-shop.vercel.app
FRONTEND_URL=https://your-frontend-domain.com

# API/Backend URL - used by frontend
# Example: https://api.matheus-leme-shop.railway.app or https://api.seu-dominio.com
VITE_API_URL=https://your-api-domain.com/api

# Webhook URL for payment notifications
# Example: https://api.seu-dominio.com/api/payments/webhook
WEBHOOK_URL=https://your-api-domain.com/api/payments/webhook

# ============================================================================
# PAYMENT INTEGRATIONS (Optional/Deprecated)
# ============================================================================
# Stripe (if still using, mark as deprecated in favor of MercadoPago)
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# MercadoPago Public Key (if needed in frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=xxxxxxxxxxxx

# ============================================================================
# EMAIL SERVICE (Optional)
# ============================================================================
# For transactional emails (order confirmations, password reset, etc.)
# Service: gmail, sendgrid, mailgun, smtp
EMAIL_SERVICE=gmail

# Gmail App Password (recommended method for Gmail)
# Generate here: https://myaccount.google.com/apppasswords
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Or use SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ============================================================================
# MONITORING & ERROR TRACKING
# ============================================================================
# Sentry for error tracking (free tier available)
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
# CRITICAL: Must be 'production' for production deployment
NODE_ENV=production

# ============================================================================
# LOGGING
# ============================================================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# ============================================================================
# DEPLOYMENT INFO (for reference)
# ============================================================================
# Platform: Railway / Render / Heroku / DigitalOcean / AWS / etc.
DEPLOYMENT_PLATFORM=railway
# Region/Location
DEPLOYMENT_REGION=us-east-1
# Deploy timestamp (set during deployment)
DEPLOYED_AT=

# ============================================================================
# CORS & SECURITY
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGIN=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Enable/disable CORS
CORS_ENABLED=true

# ============================================================================
# DATABASE POOL (Connection Pooling)
# ============================================================================
# Connection pool for production (if using standalone DB)
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# ============================================================================
# API RATE LIMITING
# ============================================================================
# Requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Requests per hour per IP
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================================================
# FILE UPLOADS
# ============================================================================
# Maximum file size (bytes)
MAX_FILE_SIZE=5242880  # 5MB

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf

# ============================================================================
# SESSION & COOKIES
# ============================================================================
# Session timeout (ms)
SESSION_TIMEOUT=86400000  # 24 hours

# Secure cookies (HTTPS only)
SECURE_COOKIES=true

# ============================================================================
# CACHE (Optional)
# ============================================================================
# Redis URL if using caching (optional)
REDIS_URL=redis://user:password@host:6379

# Cache TTL (Time To Live) in seconds
CACHE_TTL=3600

# ============================================================================
# FEATURES FLAGS
# ============================================================================
# Enable/disable features
FEATURE_STRIPE=false
FEATURE_MERCADOPAGO=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SMS_NOTIFICATIONS=false

# ============================================================================
# MAINTENANCE
# ============================================================================
# Maintenance mode (set to 'true' to enable)
MAINTENANCE_MODE=false

# Maintenance message
MAINTENANCE_MESSAGE=Site em manutenção. Por favor, tente novamente em breve.
