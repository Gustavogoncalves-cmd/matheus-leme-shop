# ============================================================================
# PRODUCTION ENVIRONMENT - Frontend Only
# ============================================================================
# Vercel/Netlify environment variables
# Set these in your deployment platform dashboard
#
# Important: Vite env vars must start with VITE_ to be exposed to browser
# ============================================================================

# API Endpoint
VITE_API_URL=https://your-backend-domain.com/api

# MercadoPago (if using in frontend)
VITE_MERCADOPAGO_PUBLIC_KEY=your_public_key_here

# Stripe (deprecated, but kept for compatibility)
VITE_STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxx

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxxxx
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Analytics (optional)
VITE_GA_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=xxxxxxxxx

# Feature Flags
VITE_FEATURE_STRIPE=false
VITE_FEATURE_MERCADOPAGO=true
VITE_FEATURE_EMAIL_NOTIFICATIONS=true

# Application Info
VITE_APP_NAME=Matheus Leme Shop
VITE_APP_VERSION=1.0.0

# Build Mode
VITE_MODE=production
