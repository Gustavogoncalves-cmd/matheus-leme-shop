# ============================================================================
# PRODUCTION ENVIRONMENT - Backend Only
# ============================================================================
# Copy to .env.production and fill actual values
# NEVER commit .env.production!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" for random secret
#
# Database connection format:
#   Railway: postgresql://user:password@container.railway.internal:5432/railway
#   Render: postgresql://user:password@dpg-xxx.render-internal:5432/database
# ============================================================================

# Server
PORT=3000
NODE_ENV=production

# Database - Managed PostgreSQL (Railway/Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Security
JWT_SECRET=your_production_jwt_secret_here_generate_cryptographically
JWT_EXPIRE=7d

# MercadoPago Integration
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=webhook_secret_from_mercadopago

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# Webhook URL (for payment notifications)
WEBHOOK_URL=https://your-backend-domain.com/api/payments/webhook

# Stripe (deprecated, but kept for compatibility)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Logging
LOG_LEVEL=info

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email Service (optional)
EMAIL_SERVICE=gmail
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=seu-app-password

# Security
CORS_ORIGIN=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Database Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# Deployment Info
DEPLOYMENT_PLATFORM=railway
DEPLOYED_AT=
